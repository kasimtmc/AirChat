<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower. Nothing is ever backed up: all app data is encrypted
   with device-bound keys and must never leave the device (requirement S-2, S-9).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
